generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AllowedUser {
  id        String   @id @default(cuid())
  email     String   @unique
  role      String   @default("tester")
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  createdBy String?
}
